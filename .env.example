# Referto Chiaro — configurazione
# Tutti i flag sensibili sono SPENTI di default. Qualsiasi valore diverso da "true" vale false.

# Modalità demo: solo fixture sintetiche, nessun dato reale. Spegnere solo fuori dalla demo pubblica.
DEMO_MODE=true

# Approvazione organizzativa di compliance (MDR/IVDR, GDPR art. 9, DPIA, contratti).
# Senza questa, nessuna funzione sensibile si attiva anche se il suo flag è "true".
PRODUCTION_COMPLIANCE_APPROVED=false

ENABLE_REAL_UPLOADS=false
ENABLE_AI_PROCESSING=false
ENABLE_LIVE_PAYMENTS=false
ENABLE_MEDICAL_SECOND_OPINION=false
ENABLE_PUBLIC_SIGNUP=false

# Database. Senza DATABASE_URL si usa PGlite (PostgreSQL embedded) nella cartella PGLITE_DATA_DIR (o in memoria).
# DATABASE_URL=postgres://utente:password@host:5432/referto_chiaro
PGLITE_DATA_DIR=.data/dev

# Solo per sviluppo su http://localhost: cookie di sessione senza flag Secure.
# COOKIE_INSECURE=true
# Limite richieste di accesso per client ogni 10 minuti (default 10).
# AUTH_RATE_LIMIT_PER_10MIN=10
