# Cura Privata — configurazione
# Tutti i flag sensibili sono SPENTI di default. Qualsiasi valore diverso da "true" vale false.

# Profilo del sito. "vetrina" = online prima della conformità: forza la demo e spegne caricamenti veri, AI, pagamenti
# (anche di test), servizi medici e registrazione, anche se gli interruttori sotto fossero accesi per errore.
# Vedi docs/cura-privata/LANCIO_VETRINA.md.
# SITE_PROFILE=vetrina

# Modalità demo: solo fixture sintetiche, nessun dato reale, link di accesso mostrato a schermo.
# "true" la accende. Se la variabile manca, è accesa solo fuori da NODE_ENV=production.
# In produzione va dichiarata esplicitamente: senza DEMO_MODE=true i pagamenti senza chiavi si bloccano.
DEMO_MODE=true

# Approvazione organizzativa di compliance (MDR/IVDR, GDPR art. 9, DPIA, contratti).
# Senza questa, nessuna funzione sensibile si attiva anche se il suo flag è "true".
PRODUCTION_COMPLIANCE_APPROVED=false

ENABLE_REAL_UPLOADS=false
ENABLE_AI_PROCESSING=false
ENABLE_LIVE_PAYMENTS=false
ENABLE_MEDICAL_SECOND_OPINION=false
# Videoconsulti «Parla con un medico» con medici reali (richiede anche la compliance).
ENABLE_MEDICAL_VIDEO_CONSULT=false
ENABLE_PUBLIC_SIGNUP=false

# Prezzi pubblici: visibili di default; "false" li nasconde ovunque.
# ENABLE_PUBLIC_PRICES=true
# Listino Evoluzione v2 in centesimi, un solo punto di verità (src/domain/offerta.ts, PRICES).
# Default: Capisci 790, primo referto 290, medico 7900, secondo parere 14900.
# PRICE_CAPISCI_CENTS=790
# PRICE_CAPISCI_FIRST_CENTS=290
# PRICE_VIDEOCONSULTO_CENTS=7900
# PRICE_SECONDO_PARERE_CENTS=14900
# Primo referto in promozione, una volta per persona (impronta dell'email normalizzata). "false" la spegne.
# FIRST_REFERTO_PROMO=true
# Sale facoltativo per l'impronta email della promozione (impostarlo una volta e non cambiarlo più).
# PROMO_SALT=
# Credito: chi ha pagato «Capisci» per un documento lo vede scalato dal videoconsulto sullo stesso documento. Spento.
# UPGRADE_CREDIT=false

# Database. Senza DATABASE_URL si usa PGlite (PostgreSQL embedded) nella cartella PGLITE_DATA_DIR (o in memoria).
# DATABASE_URL=postgres://utente:password@host:5432/cura_privata
PGLITE_DATA_DIR=.data/dev

# Solo per sviluppo su http://localhost: cookie di sessione senza flag Secure.
# COOKIE_INSECURE=true
# Limite richieste di accesso per client ogni 10 minuti (default 10); lista d'attesa (default 5).
# AUTH_RATE_LIMIT_PER_10MIN=10
# WAITLIST_RATE_LIMIT_PER_10MIN=5
# Dietro un reverse proxy fidato: usa X-Forwarded-For per distinguere i client. Senza, tutti contano come uno.
# TRUST_PROXY=true

# Pagamenti (Fase 3). Senza chiavi il checkout è SIMULATO (nessun addebito, etichettato come tale).
# Chiavi di TEST Stripe (sk_test_...): checkout reale in modalità test, nessun addebito vero.
# Chiavi LIVE (sk_live_...) richiedono ENABLE_LIVE_PAYMENTS=true + approvazione compliance + fuori demo.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# URL pubblico del sito, usato per i ritorni dal checkout (default: origine della richiesta).
# PUBLIC_BASE_URL=http://localhost:3000

# Account di servizio della demo (creati all'avvio solo in DEMO_MODE): medico e admin con 2FA TOTP.
# In demo il segreto TOTP è mostrato a schermo; fuori demo va configurato per ciascun account.
# Chiave (64 caratteri esadecimali, AES-256-GCM) per cifrare i segreti TOTP a riposo. Obbligatoria fuori demo.
# Generarla con: openssl rand -hex 32
# MFA_SECRET_KEY=

# Indicizzazione: "true" accende robots index, sitemap e canonical. Solo dopo la revisione medica dei contenuti.
ENABLE_INDEXING=false

# ---------------------------------------------------------------------------
# Servizi reali (dietro i gate). Elenco completo e ordine di accensione: docs/DEPLOY.md
# ---------------------------------------------------------------------------

# Email transazionali. Senza fornitore: casella di sviluppo (nessun invio) in demo/sviluppo; errore in produzione.
# EMAIL_PROVIDER=resend            # oppure postmark
# RESEND_API_KEY=re_...
# POSTMARK_SERVER_TOKEN=...
# EMAIL_FROM="Cura Privata <no-reply@curaprivata.it>"

# Intelligenza artificiale (Claude). Usata solo con ENABLE_AI_PROCESSING=true + compliance approvata + fuori demo.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5         # alternativa più economica da validare con npm run eval:ai: claude-sonnet-5-5
# AI_EFFORT=medium                 # low | medium | high
# AI_INFERENCE_GEO=                # regione di inferenza, se disponibile per l'account

# Caricamento file reali: chiave AES-256-GCM (64 caratteri esadecimali). Senza, nessun file viene accettato.
# Se si perde, i file caricati non si possono più leggere. Generare con: npm run keys
# FILE_ENCRYPTION_KEY=

# Cron (Vercel Cron → /api/cron/jobs): riprende i lavori rimasti in coda. Vercel lo invia come «Authorization: Bearer».
# CRON_SECRET=

# Database su Vercel/serverless: connessioni per istanza (default 3 su Vercel) e migrazioni solo al deploy.
# PG_POOL_MAX=3
# DB_RUNTIME_MIGRATIONS=false
# DATABASE_URL_UNPOOLED=postgres://...   # connessione diretta per le migrazioni (Neon); se manca si usa DATABASE_URL

# Titolare mostrato sul sito («Chi c'è dietro», fondo pagina, contatti). Senza nome E partita IVA il blocco non compare.
# PUBLIC_OWNER_NAME=
# PUBLIC_OWNER_VAT=
# PUBLIC_OWNER_ADDRESS=
# PUBLIC_OWNER_EMAIL=
# PUBLIC_OWNER_PEC=
